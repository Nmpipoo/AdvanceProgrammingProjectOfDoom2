<?xml version="1.0" encoding="UTF-8"?>
<!-- Console shows INFO and above; logs/game.log keeps everything down to DEBUG. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level [%t] %logger{1} - %msg%n"/>
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </Console>
        <File name="GameLog" fileName="logs/game.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{1} - %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="se233.project2" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="GameLog"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
